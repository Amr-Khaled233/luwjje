# PostgreSQL connection string.
# Vercel Postgres / Neon / Supabase all work. Vercel injects this for you if
# you attach a Postgres store to the project.
DATABASE_URL="postgresql://user:password@host:5432/luwjje?sslmode=require"

# Signs the dashboard session cookie and the order-access cookie. REQUIRED.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# The first-run password for /dashboard. Once a password is set through the
# emailed reset link, that hash takes over and this value stops mattering.
DASHBOARD_PASSWORD=""

# Where "Forgot the password?" sends its link. This is the only way to change
# the password — there is no form inside the dashboard — so set an address you
# can actually read, or there is no way back in if the password is lost.
PASSWORD_RESET_EMAIL=""

# Where a "new order" alert is emailed when someone checks out. Leave blank to
# reuse PASSWORD_RESET_EMAIL, or set a different inbox here.
ORDER_NOTIFICATION_EMAIL=""

# How email is sent (both the reset link and the order alert). Pick one; with
# neither, messages are printed to the server log instead (fine for local dev).
#   Resend — no dependency, called over HTTPS. Set MAIL_FROM once you have
#   verified a domain; until then Resend only delivers to your own address.
RESEND_API_KEY=""
MAIL_FROM=""
#   …or any mailbox over SMTP, including Gmail with an app password.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# The public origin. Used for reset links and for social share previews —
# without it both fall back to localhost.
NEXT_PUBLIC_SITE_URL=""

# Set automatically when you attach a Vercel Blob store. Product image uploads
# go there; without it they are written to public/uploads on local disk.
BLOB_READ_WRITE_TOKEN=""

