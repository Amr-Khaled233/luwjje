// luwjje — commerce schema
//
// PostgreSQL. Vercel's filesystem is ephemeral, so SQLite is not an option in
// production; Postgres is the single database everywhere, local included.
//
// Bilingual by design: every customer-visible string has an `*Ar` twin. When
// the Arabic field is blank the storefront falls back to the base field, so a
// half-translated catalogue still renders.
//
// There are no customer accounts. Guests check out, and the only credential in
// the app is the dashboard password on SiteSettings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- catalogue

model Category {
  id            String   @id @default(cuid())
  name          String   @unique
  nameAr        String   @default("")
  slug          String   @unique
  description   String   @default("")
  descriptionAr String   @default("")
  /// Hidden categories keep their products but drop out of the Shop filter.
  visible       Boolean  @default(true)
  position      Int      @default(0)
  createdAt     DateTime @default(now())

  products Product[]
}

model Product {
  id             String  @id @default(cuid())
  name           String
  nameAr         String  @default("")
  slug           String  @unique
  description    String  @default("")
  descriptionAr  String  @default("")
  price          Float
  compareAtPrice Float?
  sku            String? @unique
  categoryId     String?
  status         String  @default("PUBLISHED") // DRAFT | PUBLISHED
  isBestSeller   Boolean @default(false)
  bestSellerOrder Int    @default(0)
  hasSizes       Boolean @default(false)
  soldCount      Int     @default(0)
  viewCount      Int     @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category   Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images     ProductImage[]
  variants   ProductVariant[]
  orderItems OrderItem[]
  discounts  DiscountProduct[]

  @@index([status])
  @@index([isBestSeller])
  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String  @default("")
  position  Int     @default(0)
  isPrimary Boolean @default(false)
  /// Second image, revealed on card hover.
  isHover   Boolean @default(false)

  /// Where the subject sits, as a percentage of the frame. Product photos are
  /// shown in fixed aspect ratios, so a centre crop cuts an off-centre subject
  /// in half. This is the point that must stay in frame at every size.
  focalX    Int     @default(50)
  focalY    Int     @default(50)
  /// "cover" crops to fill the frame; "contain" fits the whole image inside it.
  fit       String  @default("cover")

  /// The photo's own dimensions, measured when it is uploaded. The product
  /// page sizes its frame from these so the whole image shows at its own
  /// shape — no crop, and no empty band from letterboxing it into a fixed one.
  width     Int?
  height    Int?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// One purchasable SKU = product + colour (+ optional size).
model ProductVariant {
  id            String  @id @default(cuid())
  productId     String
  colorName     String
  colorNameAr   String  @default("")
  colorHex      String  @default("#0b1c30")
  size          String? // null when the product has no sizes
  sku           String  @unique
  stock         Int     @default(0)
  lowStockAt    Int     @default(5)
  priceOverride Float?
  position      Int     @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
}

/// Which colourways appear in the Shop colour filter, and what they are
/// called there. Kept in sync with the variants by the dashboard.
model FilterColor {
  id       String  @id @default(cuid())
  name     String  @unique
  nameAr   String  @default("")
  hex      String  @default("#0b1c30")
  visible  Boolean @default(true)
  position Int     @default(0)
}

/// An editable bucket in the Shop price filter. Empty table = no price filter.
model PriceRange {
  id       String  @id @default(cuid())
  label    String
  labelAr  String  @default("")
  min      Float   @default(0)
  /// null = no upper bound ("and above").
  max      Float?
  visible  Boolean @default(true)
  position Int     @default(0)
}

// ---------------------------------------------------------------- orders

model Order {
  id            String   @id @default(cuid())
  orderNumber   String   @unique
  email         String
  fullName      String
  phone         String?
  street        String
  /// Free-text area / district within the governorate.
  area          String?
  /// Governorate name at time of order, kept even if the row is later renamed.
  governorate   String
  governorateId String?
  status        String   @default("PENDING") // PENDING | PAID | SHIPPED | DELIVERED | CANCELLED
  paymentStatus String   @default("UNPAID")  // UNPAID | PAID | REFUNDED
  paymentRef    String?
  subtotal      Float
  shippingCost  Float    @default(0)
  discount      Float    @default(0)
  total         Float
  promoCode     String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items OrderItem[]

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  variantId String?
  // Denormalised so history survives product edits and deletions.
  name      String
  nameAr    String  @default("")
  colorName String  @default("")
  size      String?
  imageUrl  String  @default("")
  unitPrice Float
  quantity  Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// ---------------------------------------------------------------- promotions

model PromoCode {
  id            String    @id @default(cuid())
  code          String    @unique
  description   String    @default("")
  descriptionAr String    @default("")
  discountType  String    @default("PERCENT") // PERCENT | FIXED
  discountValue Float
  minOrder      Float     @default(0)
  maxUses       Int? // null = unlimited
  usedCount     Int       @default(0)
  startsAt      DateTime?
  expiresAt     DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())

  @@index([active])
}

/// Makes delivery free — above a spend, during a window, or both.
///
/// A rule with only `minOrder` is the classic "free over 2,000". A rule with
/// only dates is a campaign: free delivery all week, whatever the basket. Set
/// both and it is free over 2,000 during that week only. Any live rule that
/// matches wins, so rules stack rather than override each other.
model FreeShippingRule {
  id        String    @id @default(cuid())
  name      String    @default("")
  nameAr    String    @default("")
  /// Null means any basket qualifies.
  minOrder  Float?
  /// Null on either side leaves that end open.
  startsAt  DateTime?
  endsAt    DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@index([active])
}

/// Automatic (non-code) discount campaign scoped to products or a category.
model Discount {
  id            String    @id @default(cuid())
  name          String
  nameAr        String    @default("")
  discountType  String    @default("PERCENT") // PERCENT | FIXED
  discountValue Float
  scope         String    @default("PRODUCTS") // PRODUCTS | CATEGORY | ALL
  categoryId    String?
  startsAt      DateTime?
  endsAt        DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())

  products DiscountProduct[]
}

model DiscountProduct {
  discountId String
  productId  String

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
}

// ---------------------------------------------------------------- shipping

/// One row per Egyptian governorate, each with its own delivery price.
model Governorate {
  id            String  @id @default(cuid())
  name          String  @unique
  nameAr        String
  shippingCost  Float   @default(0)
  /// Per-governorate free-shipping threshold; null falls back to the global one.
  estimatedDays String  @default("2-4")
  active        Boolean @default(true)
  position      Int     @default(0)
}

// ---------------------------------------------------------------- CMS / settings

/// Single row (id = "singleton") holding storefront-wide editable content
/// and the one dashboard credential.
model SiteSettings {
  id String @id @default("singleton")

  /// bcrypt hash of the dashboard password. Null until first set, at which
  /// point DASHBOARD_PASSWORD from .env is used instead.
  dashboardPasswordHash String?

  /// Bumped whenever the password is reset. The number is baked into every
  /// session token, so a reset invalidates sessions already open elsewhere —
  /// otherwise whoever prompted the reset would simply stay logged in.
  sessionEpoch Int @default(0)

  storeName    String @default("luwjje")
  tagline      String @default("Considered essentials for a quiet life.")
  taglineAr    String @default("")
  logoUrl      String @default("")
  supportEmail String @default("care@luwjje.com")
  supportPhone String @default("")

  /// Language shown to a first-time visitor: "en" or "ar".
  defaultLocale  String  @default("en")
  /// Turn the language switcher off to run the store in one language.
  enableArabic   Boolean @default(true)

  currencyCode     String @default("EGP")
  currencySymbol   String @default("EGP")
  currencySymbolAr String @default("ج.م")

  defaultShippingRate Float @default(75)
  lowStockThreshold   Int   @default(5)

  // Which controls the Shop filter bar offers.
  showColorFilter    Boolean @default(true)
  showCategoryFilter Boolean @default(true)
  showPriceFilter    Boolean @default(true)
  showSortFilter     Boolean @default(true)

  /// Only the two channels the store actually runs. Adding another means a
  /// column here, a field on the Settings form and an entry in the footer.
  instagramUrl String @default("")
  facebookUrl  String @default("")

  metaTitle         String @default("luwjje")
  metaTitleAr       String @default("")
  metaDescription   String @default("")
  metaDescriptionAr String @default("")
  ogImageUrl        String @default("")

  newsletterHeading   String @default("Newsletter")
  newsletterHeadingAr String @default("")
  newsletterBody      String @default("")
  newsletterBodyAr    String @default("")

  updatedAt DateTime @updatedAt @default(now())
}

/// Hero / promo banners. `slot` selects where it renders.
model Banner {
  id           String    @id @default(cuid())
  slot         String    @default("HERO") // HERO | OFFER
  eyebrow      String    @default("")
  eyebrowAr    String    @default("")
  heading      String    @default("")
  headingAr    String    @default("")
  subheading   String    @default("")
  subheadingAr String    @default("")
  body         String    @default("")
  bodyAr       String    @default("")
  ctaLabel     String    @default("Shop Now")
  ctaLabelAr   String    @default("")
  imageUrl     String    @default("")
  badge        String    @default("")
  badgeAr      String    @default("")
  active       Boolean   @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  position     Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([slot, active])
}

/// Swatches for the "Colour Palette" showcase strip on the home page.
model PaletteSwatch {
  id       String @id @default(cuid())
  name     String
  nameAr   String @default("")
  hex      String
  position Int    @default(0)
}

/// Editable content pages: about, journal, privacy-policy, terms…
model Page {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  titleAr      String   @default("")
  excerpt      String   @default("")
  excerptAr    String   @default("")
  body         String   @default("")
  bodyAr       String   @default("")
  heroImage    String   @default("")
  published    Boolean  @default(true)
  showInFooter Boolean  @default(false)
  position     Int      @default(0)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

/// A single outstanding "forgot password" link.
///
/// Only the SHA-256 of the token is stored — a database dump must not hand
/// anyone a working reset link. The row is kept after use rather than deleted
/// so a replayed link can be told apart from an expired one.
model PasswordReset {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

/// Lightweight funnel tracking so Conversion Rate / traffic sources are real.
model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String   @default("direct")
  sessionId String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
